      "name": "سُورَةُ الهُمَزَةِ",
      "englishName": "Al-Humaza",
      "englishNameTranslation": "The Traducer",
      "numberOfAyahs": 9,
      "ayahs": [
        {
          "numberInSurah": 1,
          "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَیۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ\n"
        },
        {
          "numberInSurah": 2,
          "text": "ٱلَّذِی جَمَعَ مَالࣰا وَعَدَّدَهُۥ\n"
        },
        {
          "numberInSurah": 3,
          "text": "یَحۡسَبُ أَنَّ مَالَهُۥۤ أَخۡلَدَهُۥ\n"
        },
        {
          "numberInSurah": 4,
          "text": "كَلَّاۖ لَیُنۢبَذَنَّ فِی ٱلۡحُطَمَةِ\n"
        },
        {
          "numberInSurah": 5,
          "text": "وَمَاۤ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ\n"
        },
        {
          "numberInSurah": 6,
          "text": "نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ\n"
        },
        {
          "numberInSurah": 7,
          "text": "ٱلَّتِی تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ\n"
        },
        {
          "numberInSurah": 8,
          "text": "إِنَّهَا عَلَیۡهِم مُّؤۡصَدَةࣱ\n"
        },
        {
          "numberInSurah": 9,
          "text": "فِی عَمَدࣲ مُّمَدَّدَةِۭ\n"
        }
      ]
    },
    {
      "number": 105,
      "name": "سُورَةُ الفِيلِ",
      "englishName": "Al-Fil",
      "englishNameTranslation": "The Elephant",
      "numberOfAyahs": 5,
      "ayahs": [
        {
          "numberInSurah": 1,
          "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ أَلَمۡ تَرَ كَیۡفَ فَعَلَ رَبُّكَ بِأَصۡحَـٰبِ ٱلۡفِیلِ\n"
        },
        {
          "numberInSurah": 2,
          "text": "أَلَمۡ یَجۡعَلۡ كَیۡدَهُمۡ فِی تَضۡلِیلࣲ\n"
        },
        {
          "numberInSurah": 3,
          "text": "وَأَرۡسَلَ عَلَیۡهِمۡ طَیۡرًا أَبَابِیلَ\n"
        },
        {
          "numberInSurah": 4,
          "text": "تَرۡمِیهِم بِحِجَارَةࣲ مِّن سِجِّیلࣲ\n"
        },
        {
          "numberInSurah": 5,
          "text": "فَجَعَلَهُمۡ كَعَصۡفࣲ مَّأۡكُولِۭ\n"
        }
      ]
    },
    {
      "number": 106,
      "name": "سُورَةُ قُرَيۡشٍ",
      "englishName": "Quraish",
      "englishNameTranslation": "Quraysh",
      "numberOfAyahs": 4,
      "ayahs": [
        {
          "numberInSurah": 1,
          "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ لِإِیلَـٰفِ قُرَیۡشٍ\n"
        },
        {
          "numberInSurah": 2,
          "text": "إِۦلَـٰفِهِمۡ رِحۡلَةَ ٱلشِّتَاۤءِ وَٱلصَّیۡفِ\n"
        },
        {
          "numberInSurah": 3,
          "text": "فَلۡیَعۡبُدُوا۟ رَبَّ هَـٰذَا ٱلۡبَیۡتِ\n"
        },
        {
          "numberInSurah": 4,
          "text": "ٱلَّذِیۤ أَطۡعَمَهُم مِّن جُوعࣲ وَءَامَنَهُم مِّنۡ خَوۡفِۭ\n"
        }
      ]
    },
    {
      "number": 107,
      "name": "سُورَةُ المَاعُونِ",
      "englishName": "Al-Maa'un",
      "englishNameTranslation": "Almsgiving",
      "numberOfAyahs": 7,
      "ayahs": [
        {
          "numberInSurah": 1,
          "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ أَرَءَیۡتَ ٱلَّذِی یُكَذِّبُ بِٱلدِّینِ\n"
        },
        {
          "numberInSurah": 2,
          "text": "فَذَ ٰ⁠لِكَ ٱلَّذِی یَدُعُّ ٱلۡیَتِیمَ\n"
        },
        {
          "numberInSurah": 3,
          "text": "وَلَا یَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِینِ\n"
        },
        {
          "numberInSurah": 4,
          "text": "فَوَیۡلࣱ لِّلۡمُصَلِّینَ\n"
        },
        {
          "numberInSurah": 5,
          "text": "ٱلَّذِینَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ\n"
        },
        {
          "numberInSurah": 6,
          "text": "ٱلَّذِینَ هُمۡ یُرَاۤءُونَ\n"
        },
        {
          "numberInSurah": 7,
          "text": "وَیَمۡنَعُونَ ٱلۡمَاعُونَ\n"
        }
      ]
    },
    {
      "number": 108,
      "name": "سُورَةُ الكَوۡثَرِ",
      "englishName": "Al-Kawthar",
      "englishNameTranslation": "Abundance",
      "numberOfAyahs": 3,
      "ayahs": [
        {
          "numberInSurah": 1,
          "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ إِنَّاۤ أَعۡطَیۡنَـٰكَ ٱلۡكَوۡثَرَ\n"
        },
        {
          "numberInSurah": 2,
          "text": "فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ\n"
        },
        {
          "numberInSurah": 3,
          "text": "إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ\n"
        }
      ]
    },
    {
      "number": 109,
      "name": "سُورَةُ الكَافِرُونَ",
      "englishName": "Al-Kaafiroon",
      "englishNameTranslation": "The Disbelievers",
      "numberOfAyahs": 6,
      "ayahs": [
        {
          "numberInSurah": 1,
          "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ قُلۡ یَـٰۤأَیُّهَا ٱلۡكَـٰفِرُونَ\n"
        },
        {
          "numberInSurah": 2,
          "text": "لَاۤ أَعۡبُدُ مَا تَعۡبُدُونَ\n"
        },
        {
          "numberInSurah": 3,
          "text": "وَلَاۤ أَنتُمۡ عَـٰبِدُونَ مَاۤ أَعۡبُدُ\n"
        },
        {
          "numberInSurah": 4,
          "text": "وَلَاۤ أَنَا۠ عَابِدࣱ مَّا عَبَدتُّمۡ\n"
        },
        {
          "numberInSurah": 5,
          "text": "وَلَاۤ أَنتُمۡ عَـٰبِدُونَ مَاۤ أَعۡبُدُ\n"
        },
        {
          "numberInSurah": 6,
          "text": "لَكُمۡ دِینُكُمۡ وَلِیَ دِینِ\n"
        }
      ]
    },
    {
      "number": 110,
      "name": "سُورَةُ النَّصۡرِ",
      "englishName": "An-Nasr",
      "englishNameTranslation": "Divine Support",
      "numberOfAyahs": 3,
      "ayahs": [
        {
          "numberInSurah": 1,
          "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ إِذَا جَاۤءَ نَصۡرُ ٱللَّهِ وَٱلۡفَتۡحُ\n"
        },
        {
          "numberInSurah": 2,
          "text": "وَرَأَیۡتَ ٱلنَّاسَ یَدۡخُلُونَ فِی دِینِ ٱللَّهِ أَفۡوَاجࣰا\n"
        },
        {
          "numberInSurah": 3,
          "text": "فَسَبِّحۡ بِحَمۡدِ رَبِّكَ وَٱسۡتَغۡفِرۡهُۚ إِنَّهُۥ كَانَ تَوَّابَۢا\n"
        }
      ]
    },
    {
      "number": 111,
      "name": "سُورَةُ المَسَدِ",
      "englishName": "Al-Masad",
      "englishNameTranslation": "The Palm Fibre",
      "numberOfAyahs": 5,
      "ayahs": [
        {
          "numberInSurah": 1,
          "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ تَبَّتۡ یَدَاۤ أَبِی لَهَبࣲ وَتَبَّ\n"
        },
        {
          "numberInSurah": 2,
          "text": "مَاۤ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ\n"
        },
        {
          "numberInSurah": 3,
          "text": "سَیَصۡلَىٰ نَارࣰا ذَاتَ لَهَبࣲ\n"
        },
        {
          "numberInSurah": 4,
          "text": "وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ\n"
        },
        {
          "numberInSurah": 5,
          "text": "فِی جِیدِهَا حَبۡلࣱ مِّن مَّسَدِۭ\n"
        }
      ]
    },
    {
      "number": 112,
      "name": "سُورَةُ الإِخۡلَاصِ",
      "englishName": "Al-Ikhlaas",
      "englishNameTranslation": "Sincerity",
      "numberOfAyahs": 4,
      "ayahs": [
        {
          "numberInSurah": 1,
          "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ قُلۡ هُوَ ٱللَّهُ أَحَدٌ\n"
        },
        {
          "numberInSurah": 2,
          "text": "ٱللَّهُ ٱلصَّمَدُ\n"
        },
        {
          "numberInSurah": 3,
          "text": "لَمۡ یَلِدۡ وَلَمۡ یُولَدۡ\n"
        },
        {
          "numberInSurah": 4,
          "text": "وَلَمۡ یَكُن لَّهُۥ كُفُوًا أَحَدُۢ\n"
        }
      ]
    },
    {
      "number": 113,
      "name": "سُورَةُ الفَلَقِ",
      "englishName": "Al-Falaq",

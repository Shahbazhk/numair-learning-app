{
  "title": "English — CBSE Grade 1 Complete",
  "grade": 1,
  "depth": "deep",
  "sections": [
    {
      "id": "letters-and-sounds",
      "icon": "📖",
      "title": "Letters and Sounds",
      "explanation": "Learn letter shapes and the sounds they usually make when reading aloud.",
      "points": [
        "A–Z recognition",
        "Beginning sounds",
        "Trace letters carefully"
      ],
      "examples": [
        {
          "title": "Sound",
          "problem": "Ball starts with sound…",
          "steps": [
            "b"
          ],
          "answer": "/b/"
        }
      ]
    },
    {
      "id": "simple-words-cvc",
      "icon": "✏️",
      "title": "Simple Words (CVC)",
      "explanation": "Consonant-vowel-consonant words like cat, pen, sun are great early readers.",
      "points": [
        "Blend sounds",
        "Short vowels",
        "Picture matching"
      ],
      "examples": [
        {
          "title": "Blend",
          "problem": "c-a-t makes…",
          "steps": [
            "Blend"
          ],
          "answer": "cat"
        }
      ]
    },
    {
      "id": "sight-words",
      "icon": "🗣️",
      "title": "Sight Words",
      "explanation": "Some words we recognise by sight: I, am, the, is, you, we.",
      "points": [
        "Flashcard practice",
        "Find in sentences",
        "Use in speaking"
      ],
      "examples": [
        {
          "title": "Sight",
          "problem": "Complete: ___ am Numair.",
          "steps": [
            "Sight word"
          ],
          "answer": "I"
        }
      ]
    },
    {
      "id": "naming-words",
      "icon": "📝",
      "title": "Naming Words",
      "explanation": "Nouns name people, places and things we can talk about.",
      "points": [
        "Person place thing",
        "Capital for names",
        "Point and name"
      ],
      "examples": [
        {
          "title": "Noun",
          "problem": "Delhi is a…",
          "steps": [
            "Place"
          ],
          "answer": "Place name"
        }
      ]
    },
    {
      "id": "action-words",
      "icon": "📚",
      "title": "Action Words",
      "explanation": "Verbs show actions: run, jump, read, eat.",
      "points": [
        "Act it out",
        "Present action",
        "Picture verbs"
      ],
      "examples": [
        {
          "title": "Verb",
          "problem": "Birds ___ in the sky.",
          "steps": [
            "fly"
          ],
          "answer": "fly"
        }
      ]
    },
    {
      "id": "this-that-these-those",
      "icon": "🔤",
      "title": "This / That / These / Those",
      "explanation": "Pointing words help us talk about near and far things.",
      "points": [
        "This/these near",
        "That/those far",
        "Singular plural"
      ],
      "examples": [
        {
          "title": "Point",
          "problem": "Book in hand: ___ is my book.",
          "steps": [
            "Near"
          ],
          "answer": "This"
        }
      ]
    },
    {
      "id": "simple-sentences",
      "icon": "💬",
      "title": "Simple Sentences",
      "explanation": "A sentence starts with a capital and often ends with a full stop.",
      "points": [
        "Capital start",
        "Full stop",
        "Make sense"
      ],
      "examples": [
        {
          "title": "Write",
          "problem": "Fix: i like mangoes",
          "steps": [
            "Capital & stop"
          ],
          "answer": "I like mangoes."
        }
      ]
    },
    {
      "id": "rhymes-and-listening",
      "icon": "✍️",
      "title": "Rhymes and Listening",
      "explanation": "Rhymes build music of English and memory for young learners.",
      "points": [
        "Listen carefully",
        "Clap rhythm",
        "Guess rhyming words"
      ],
      "examples": [
        {
          "title": "Rhyme",
          "problem": "Cat rhymes with…",
          "steps": [
            "hat"
          ],
          "answer": "hat"
        }
      ]
    },
    {
      "id": "myself-speaking",
      "icon": "🎭",
      "title": "Myself — Speaking",
      "explanation": "Introduce yourself politely: name, age, school, favourite colour.",
      "points": [
        "Eye contact",
        "Clear voice",
        "Short sentences"
      ],
      "examples": [
        {
          "title": "Speak",
          "problem": "My name is…",
          "steps": [
            "Introduction"
          ],
          "answer": "Say your name"
        }
      ]
    },
    {
      "id": "picture-reading",
      "icon": "📰",
      "title": "Picture Reading",
      "explanation": "Talk about what you see in a picture before reading text.",
      "points": [
        "Who what where",
        "New words",
        "Full sentence answers"
      ],
      "examples": [
        {
          "title": "Pic",
          "problem": "If you see a school bus, where might children go?",
          "steps": [
            "School"
          ],
          "answer": "To school"
        }
      ]
    }
  ],
